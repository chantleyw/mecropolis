{
  "name": "mecropolis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "sanity schema extract --path sanity/extract.json && sanity typegen generate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "dev:api": "wrangler pages dev public --port 8788 --env-file .env.local",
    "deploy": "vite build && wrangler pages deploy dist --project-name=mecropolis"
  },
  "dependencies": {
    "@sanity/client": "^8.6.2",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/sdk-react": "^3.3.0",
    "@sanity/ui": "^4.2.1",
    "@sanity/vision": "^6.15.0",
    "bcryptjs": "^3.0.3",
    "groq": "^6.15.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sanity": "^6.15.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.8.0",
    "uuid": "^14.0.2"
  }
}
