{
  "name": "mecropolis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "wrangler pages dev public --port 8788 --env-file .env.local",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=mecropolis",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions && tsc --noEmit -p sanity-functions",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "sanity schema extract --path sanity/extract.json && sanity typegen generate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "migrate:notes": "tsx --env-file=.env.local scripts/migrate-notes.ts",
    "migrate:owners": "tsx --env-file=.env.local scripts/migrate-note-owners.ts"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "groq": "^6.15.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sanity": "^6.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.8.0",
    "uuid": "^14.0.2"
  }
}
