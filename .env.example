# Vite SPA rebuild (App SDK plan, Milestone 1+); coexists with the Next vars below until the
# Next app is removed in Milestone 8.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_WRITE_TOKEN=
# Viewer-role token for reads: npx sanity tokens create "read client" --role=viewer --yes
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=
AUTH_SECRET=
AUTH_DEMO_USER=
# bcrypt hash: node scripts/hash-password.mjs "<password>" (output is already escaped for .env.local)
AUTH_DEMO_PASSWORD_HASH=
# Shared secret Vercel Cron sends as a Bearer token to /api/advance (32+ chars)
CRON_SECRET=
# USDA FAS PSD API key (https://api.fas.usda.gov)
FAS_API_KEY=
