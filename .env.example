# Browser (inlined by Vite) and the Sanity CLI
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
# Pages Functions (read locally by `npm run dev:api`; set in production with
# `npx wrangler pages secret put <NAME> --project-name=mecropolis`)
# HMAC key for session cookies (32+ chars); rotating it signs everyone out
SESSION_SECRET=
DEMO_USER=
DEMO_PASSWORD=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=
# Shared secret sent as a Bearer token to authenticate /api/advance (32+ chars)
CRON_SECRET=
# USDA FAS PSD API key (https://api.fas.usda.gov)
FAS_API_KEY=
